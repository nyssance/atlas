{
  "name": "@nyssance/atlas",
  "version": "0.1.2",
  "description": "Framework-independent sliding region layouts, powered by Embla.",
  "type": "module",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/nyssance/atlas.git"
  },
  "files": [
    "dist",
    "rust/Cargo.toml",
    "rust/src",
    "rust/rustfmt.toml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "ALWITH-LICENSE.md",
    "LICENSES"
  ],
  "exports": {
    ".": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./dom": {
      "types": "./dist/dom.d.ts",
      "import": "./dist/dom.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js"
    },
    "./angular": {
      "types": "./dist/angular.d.ts",
      "import": "./dist/angular.js"
    },
    "./svelte": {
      "types": "./dist/svelte.d.ts",
      "import": "./dist/svelte.js"
    },
    "./tauri": {
      "types": "./dist/tauri.d.ts",
      "import": "./dist/tauri.js"
    },
    "./styles.css": "./dist/styles.css",
    "./station": {
      "types": "./dist/station.d.ts",
      "import": "./dist/station.js"
    },
    "./layout": {
      "types": "./dist/layout.d.ts",
      "import": "./dist/layout.js"
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "bun scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/core.test.ts tests/station.test.ts",
    "test:browser": "playwright test",
    "ts7-lint": "ts7-lint"
  },
  "dependencies": {
    "embla-carousel": "^8.6.0",
    "motion": "^14.6.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "vue": "^3.5.0",
    "@angular/core": ">=20 <24",
    "svelte": "^5.0.0",
    "@tauri-apps/api": ">=2 <4"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "@tauri-apps/api": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@nyssance/ts7-lint": "^0.1.3",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/api": "^3.0.0-alpha.3",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rxjs": "^7.8.2",
    "svelte": "^5.57.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vue": "^3.5.44"
  },
  "publishConfig": {
    "access": "public"
  }
}
